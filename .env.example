# Environment Variables Configuration Template
# Copy this file to .env and fill in your secrets and local configuration

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Market Data API Settings (e.g. CoinGecko, AlphaVantage, Yahoo Finance)
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Storage & Lakehouse
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_FEATURES_DIR=./data/features

# Database & Metadata Backend
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=mlops_password
POSTGRES_DB=anomaly_detection_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mlops_user:mlops_password@localhost:5432/anomaly_detection_db

# MLflow Experiment Tracking & Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=asset-anomaly-detection
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=mlflow-artifacts,data-lake
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Airflow Settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
